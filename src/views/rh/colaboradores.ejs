<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Colaboradores | Vision Agro</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="app-layout"><%- include('../partials/sidebar', { active: 'colaboradores' }) %><div class="main-content">
    
    <main class="page">
        <div class="page-heading">
            <div><span class="eyebrow">RECURSOS HUMANOS</span><h1>Colaboradores</h1><p>Lista de pessoas cadastradas na Vision Agro.</p></div>
            <a class="button button-primary" href="/rh/colaboradores/novo">+ Novo colaborador</a>
        </div>
        <div class="table-card">
            <div class="table-toolbar"><strong>Equipe cadastrada</strong><span><%= colaboradores.length %> registro(s)</span></div>
            <div class="table-wrap"><table>
                <thead><tr><th>Colaborador</th><th>Cargo</th><th>Departamento</th><th>Salário</th><th>Contratação</th><th>Status</th><th>Ações</th></tr></thead>
                <tbody>
                <% if (colaboradores.length === 0) { %>
                    <tr><td colspan="7" class="empty">Nenhum colaborador cadastrado.</td></tr>
                <% } %>
                <% colaboradores.forEach(colaborador => { %>
                    <tr>
                        <td><strong><%= colaborador.nome %></strong><small><%= colaborador.email %></small></td>
                        <td><%= colaborador.cargo %></td>
                        <td><span class="department-tag"><%= colaborador.departamento %></span></td>
                        <td class="salary"><%= colaborador.salario === null || colaborador.salario === undefined ? 'Não informado' : Number(colaborador.salario).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></td>
                        <td><%= colaborador.data_admissao ? new Date(colaborador.data_admissao + 'T00:00:00').toLocaleDateString('pt-BR') : '—' %></td>
                        <td><span class="status <%= colaborador.status === 'Ativo' ? 'status-ativo' : 'status-inativo' %>"><%= colaborador.status %></span></td>
                        <td><div class="actions-cell"><a class="button button-secondary button-small" href="/rh/colaboradores/<%= colaborador.id %>/editar">Editar</a><form action="/rh/colaboradores/<%= colaborador.id %>/excluir" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este colaborador? Esta ação não pode ser desfeita.');"><button class="button button-danger button-small" type="submit">Excluir</button></form></div></td>
                    </tr>
                <% }); %>
                </tbody>
            </table></div>
        </div>
    </main>
</div></div>
</body>
</html>